#!/usr/bin/env bash
# Pre-push: the engine pin must still be a contract.
#
# Local builds patch `omawarden` to the sibling checkout while CI fetches the
# pinned revision, so a push is the moment the two can silently disagree. That
# is why this runs the pin check in *strict* mode: a local build may sit ahead
# of the pin (ADR 0007), but a push must be reproducible from the pin alone,
# so the sibling has to be checked out at it. `scripts/check_ci.sh` has the rest.
#
# Installed by `scripts/install_hooks.sh` (`mise run hooks`). Kept in the tree
# rather than in `.git/hooks` so it is reviewed and versioned.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

ENGINE_PIN_STRICT=1 bash "$ROOT/scripts/check_engine_pin.sh"
